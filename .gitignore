# large / regenerable artifacts
*.gguf
*.pth
*.safetensors
__pycache__/
*.pyc
*.log
.cache/
*.sqlite-wal
*.sqlite-shm

# wrap-up working dirs (keep the scripts + summaries, ignore venvs/results)
.wrapup/evalpy/
.wrapup/msenv/
.wrapup/wres/
.wrapup/lmenv/

# DB backups
experiments.sqlite.bak*
.pi/

# raw per-panel artifacts: only the per-item eval artefacts ship, because they are
# the evidence behind "no all-Exception cell carries a score" and the item counts;
# everything else under mres/ (samples .jsonl, probe dumps) is rebuildable and stays out.
.wrapup/mres/
!.wrapup/mres/
.wrapup/mres/*
!.wrapup/mres/*_eval.json
.wrapup/*.log
.wrapup/jars/
.wrapup/evalpy/
.wrapup/msenv/
.wrapup/bfclenv/
.wrapup/mplenv/

# other regenerable state (download markers, generated corpora, run scratch)
.wrapup/dl_ready/
.wrapup/ppl_corpora/
.wrapup/.keeper.lock
.wrapup/javac.*.args

figures/

# transient buffers: no fact lives here, safe for any agent to delete
.tmp/
